# Origen del servidor de juego (apps/server) cuando la web y el servidor están en dominios distintos,
# por ejemplo en producción: https://atacknimal-server.onrender.com
# En desarrollo déjala vacía: Vite reenvía /socket.io al servidor local (vite.config.ts).
VITE_GAME_SERVER_URL=

# Dirección pública de la web para los enlaces y el QR de las salas. Vacía: la de la página.
# En desarrollo, para escanear el QR con el celular en la misma Wi-Fi: http://192.168.1.2:5173
VITE_PUBLIC_APP_URL=
