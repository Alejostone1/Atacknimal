# Copia este archivo como .env (no se versiona) o define las variables en tu entorno.
# Node 24 puede cargarlo con: node --env-file=.env src/main.ts

PORT=3001
HOST=0.0.0.0

# PostgreSQL de producción. Si no se define, se usa PGlite (PostgreSQL embebido).
# DATABASE_URL=postgres://usuario:clave@localhost:5432/atacknimal

# Carpeta de datos de PGlite. Si no se define, PGlite trabaja en memoria.
# PGLITE_DIR=./.data/pglite

# Origen permitido para Socket.IO fuera del proxy de Vite.
CORS_ORIGIN=http://localhost:5173

# Tiempos de turno online (docs/GAME_RULES.md §16).
DECLARE_SECONDS=30
DEFEND_SECONDS=20
RECONNECT_GRACE_SECONDS=60
